---
import { site } from '../data/site';
import { url } from '../utils';
const roles = ['agentic AI', 'LLM tooling', 'the modern web', 'ideas worth sharing'];
---
<section class="hero">
  <canvas id="constellation" aria-hidden="true"></canvas>
  <div class="blob b1" aria-hidden="true"></div>
  <div class="blob b2" aria-hidden="true"></div>
  <div class="blob b3" aria-hidden="true"></div>

  <div class="container hero-inner">
    <p class="eyebrow hero-in" style="--d:0">Hello, world</p>
    <h1 class="hero-in" style="--d:1">
      I'm <span class="gradient-text">{site.name}</span>
    </h1>
    <p class="hero-sub hero-in" style="--d:2">
      Learning, building &amp; writing about{' '}
      <span class="typewriter" data-words={JSON.stringify(roles)}>{roles[0]}</span><span class="caret">|</span>
    </p>
    <p class="hero-tagline hero-in" style="--d:3">{site.tagline}</p>
    <div class="hero-cta hero-in" style="--d:4">
      <a class="btn btn-primary" href={url('/topics')}>Explore topics →</a>
      <a class="btn" href="#about">About me</a>
    </div>
  </div>
  <a class="scroll-hint" href="#about" aria-label="Scroll down"><span></span></a>
</section>

<style>
  .hero {
    position: relative; overflow: hidden; isolation: isolate;
    min-height: calc(100vh - 64px); min-height: calc(100svh - 64px);
    display: grid; align-items: center;
  }
  #constellation { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; }
  .blob {
    position: absolute; z-index: -2; border-radius: 50%; filter: blur(70px); opacity: 0.45;
    animation: float 18s ease-in-out infinite alternate;
  }
  .b1 { width: 420px; height: 420px; background: var(--accent); top: -80px; left: -100px; }
  .b2 { width: 360px; height: 360px; background: var(--accent-2); bottom: -60px; right: -60px; animation-delay: -6s; }
  .b3 { width: 300px; height: 300px; background: var(--accent-3); top: 40%; left: 55%; animation-delay: -12s; opacity: 0.3; }
  @keyframes float {
    0% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(60px, 40px) scale(1.1); }
    100% { transform: translate(-40px, 70px) scale(0.95); }
  }

  .hero-inner { padding: 60px 20px; }
  h1 { font-size: clamp(2.6rem, 8vw, 5.4rem); margin: 8px 0 12px; }
  .gradient-text {
    background: linear-gradient(90deg, var(--accent), var(--accent-2), var(--accent-3), var(--accent));
    background-size: 300% 100%; -webkit-background-clip: text; background-clip: text; color: transparent;
    animation: shine 8s linear infinite;
  }
  @keyframes shine { to { background-position: 300% 0; } }
  .hero-sub { font-size: clamp(1.2rem, 2.6vw, 1.7rem); font-family: var(--font-display); margin: 0; }
  .typewriter { color: var(--accent); font-weight: 700; }
  .caret { color: var(--accent); animation: blink 1s steps(1) infinite; margin-left: 2px; }
  @keyframes blink { 50% { opacity: 0; } }
  .hero-tagline { color: var(--muted); max-width: 560px; margin: 16px 0 32px; }
  .hero-cta { display: flex; gap: 12px; flex-wrap: wrap; }

  .hero-in { opacity: 0; transform: translateY(20px); animation: rise 0.8s cubic-bezier(.2,.7,.2,1) forwards; animation-delay: calc(var(--d) * 120ms + 100ms); }
  @keyframes rise { to { opacity: 1; transform: none; } }

  .scroll-hint {
    position: absolute; bottom: 28px; left: 50%; transform: translateX(-50%);
    width: 26px; height: 42px; border: 2px solid var(--muted); border-radius: 14px;
  }
  .scroll-hint span {
    position: absolute; top: 8px; left: 50%; width: 4px; height: 8px; margin-left: -2px;
    border-radius: 2px; background: var(--muted); animation: wheel 1.8s ease-in-out infinite;
  }
  @keyframes wheel { 0% { opacity: 1; transform: translateY(0); } 100% { opacity: 0; transform: translateY(14px); } }

  @media (prefers-reduced-motion: reduce) { .hero-in { opacity: 1; transform: none; } }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let cleanup: (() => void) | null = null;

  function typewriter() {
    const el = document.querySelector<HTMLElement>('.typewriter');
    if (!el || reduce) return () => {};
    const words: string[] = JSON.parse(el.dataset.words || '[]');
    let w = 0, i = words[0].length, deleting = true, timer = 0;
    const tick = () => {
      const word = words[w];
      i += deleting ? -1 : 1;
      el.textContent = word.slice(0, i);
      let delay = deleting ? 45 : 90;
      if (!deleting && i === word.length) { deleting = true; delay = 1800; }
      else if (deleting && i === 0) { deleting = false; w = (w + 1) % words.length; delay = 350; }
      timer = window.setTimeout(tick, delay);
    };
    timer = window.setTimeout(tick, 2200);
    return () => clearTimeout(timer);
  }

  function constellation() {
    const canvas = document.getElementById('constellation') as HTMLCanvasElement | null;
    const ctx = canvas?.getContext('2d');
    if (!canvas || !ctx || reduce) return () => {};
    let w = 0, h = 0, raf = 0;
    const mouse = { x: -9999, y: -9999 };
    type P = { x: number; y: number; vx: number; vy: number };
    let pts: P[] = [];
    const resize = () => {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      w = canvas.clientWidth; h = canvas.clientHeight;
      canvas.width = w * dpr; canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const n = Math.round(Math.min(90, (w * h) / 14000));
      pts = Array.from({ length: n }, () => ({
        x: Math.random() * w, y: Math.random() * h,
        vx: (Math.random() - 0.5) * 0.4, vy: (Math.random() - 0.5) * 0.4,
      }));
    };
    const color = () => getComputedStyle(document.documentElement).getPropertyValue('--accent').trim() || '#6d4aff';
    let c = color();
    const themeObs = new MutationObserver(() => (c = color()));
    themeObs.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    const draw = () => {
      ctx.clearRect(0, 0, w, h);
      ctx.fillStyle = c; ctx.strokeStyle = c;
      for (const p of pts) {
        p.x += p.vx; p.y += p.vy;
        if (p.x < 0 || p.x > w) p.vx *= -1;
        if (p.y < 0 || p.y > h) p.vy *= -1;
        const dx = p.x - mouse.x, dy = p.y - mouse.y, d = Math.hypot(dx, dy);
        if (d < 120) { p.x += dx / d; p.y += dy / d; }
      }
      for (let i = 0; i < pts.length; i++) {
        const a = pts[i];
        ctx.globalAlpha = 0.6; ctx.beginPath(); ctx.arc(a.x, a.y, 1.6, 0, Math.PI * 2); ctx.fill();
        for (let j = i + 1; j < pts.length; j++) {
          const b = pts[j], d = Math.hypot(a.x - b.x, a.y - b.y);
          if (d < 130) {
            ctx.globalAlpha = (1 - d / 130) * 0.35; ctx.lineWidth = 1;
            ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
          }
        }
      }
      ctx.globalAlpha = 1;
      raf = requestAnimationFrame(draw);
    };
    const onMove = (e: PointerEvent) => {
      const r = canvas.getBoundingClientRect();
      mouse.x = e.clientX - r.left; mouse.y = e.clientY - r.top;
    };
    const onLeave = () => { mouse.x = mouse.y = -9999; };
    resize(); draw();
    window.addEventListener('resize', resize);
    canvas.parentElement?.addEventListener('pointermove', onMove);
    canvas.parentElement?.addEventListener('pointerleave', onLeave);
    return () => {
      cancelAnimationFrame(raf); themeObs.disconnect();
      window.removeEventListener('resize', resize);
    };
  }

  document.addEventListener('astro:page-load', () => {
    cleanup?.();
    if (!document.querySelector('.hero')) { cleanup = null; return; }
    const a = typewriter(), b = constellation();
    cleanup = () => { a(); b(); };
  });
  document.addEventListener('astro:before-swap', () => { cleanup?.(); cleanup = null; });
</script>
